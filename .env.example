# Copy this file to .env for local development. Values below are non-secret examples only.

# Runtime mode: development, test, staging, or production.
APP_ENV=development

# Local demo login switch. Must be false outside local/test use and is rejected in production.
DEMO_AUTH_ENABLED=false

# Synthetic provider adapter switch. Must be false outside local/test use and is rejected in production.
MOCK_INTEGRATIONS_ENABLED=false

# PostgreSQL container settings for local development.
POSTGRES_DB=outcomeos
POSTGRES_USER=outcomeos
# Local development only. Choose a value and never commit the populated .env.
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Keep this URL consistent with the POSTGRES_* values above. Outside local development, supply it
# through the runtime secret store instead of committing credentials.
DATABASE_URL=postgresql://outcomeos:change-me@localhost:5432/outcomeos

# Background worker polling interval in seconds.
WORKER_POLL_INTERVAL_SECONDS=5

# Reserved for future job coordination and rate limiting; Redis is not in the current Compose stack.
REDIS_URL=redis://localhost:6379/0

# Reserved for future evidence storage; object storage is not in the current Compose stack.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=outcomeos-local

# Browser-visible API origin; never place a secret in a NEXT_PUBLIC variable.
NEXT_PUBLIC_API_URL=http://localhost:8000
