# Runtime mode: development, test, staging, or production
APP_ENV=development

# DEMO ONLY. Both flags MUST remain false in production; services fail at startup otherwise.
DEMO_AUTH_ENABLED=true
MOCK_INTEGRATIONS_ENABLED=true

POSTGRES_DB=outcomeos
POSTGRES_USER=outcomeos
# Local development only; choose your own value and never commit the populated .env.
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://outcomeos:change-me@localhost:5432/outcomeos
WORKER_POLL_INTERVAL_SECONDS=5
NEXT_PUBLIC_API_URL=http://localhost:8000
