APP_ENV=development
PERSISTENCE_BACKEND=postgresql
DATABASE_URL=postgresql+psycopg://outcomeos:outcomeos@localhost:5432/outcomeos
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=outcomeos-evidence
S3_ACCESS_KEY_ID=outcomeos
S3_SECRET_ACCESS_KEY=outcomeos-local-only
DEMO_AUTH_ENABLED=true
MOCK_INTEGRATIONS_ENABLED=true
AI_PROVIDER=deterministic_sandbox
AI_MODEL=deterministic-sandbox-v1
AI_API_KEY=
WEBHOOK_SANDBOX_SECRET=change-me-local-webhook-secret
FRONTEND_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000
OUTCOMEOS_DEMO_DB=/tmp/outcomeos-demo.json
# Provider-neutral OIDC configuration. Leave unset only for an isolated local sandbox.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:3000/auth/callback
SESSION_SECRET=change-me-local-session-secret
API_KEY_PEPPER=change-me-local-api-key-pepper
