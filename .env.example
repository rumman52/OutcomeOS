# Runtime mode: development, test, staging, or production
APP_ENV=development

# DEMO ONLY. Both flags MUST remain false in production; services fail at startup otherwise.
DEMO_AUTH_ENABLED=true
MOCK_INTEGRATIONS_ENABLED=true

DATABASE_URL=postgresql://outcomeos:outcomeos@localhost:5432/outcomeos
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=outcomeos
S3_SECRET_ACCESS_KEY=local-development-only
S3_BUCKET=outcomeos
NEXT_PUBLIC_API_URL=http://localhost:8000
