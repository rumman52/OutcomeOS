# Copy this file to .env for local development. Values below are non-secret examples only.

# Runtime mode: development, test, staging, or production.
APP_ENV=development

# Local demo login switch. Must be false outside local/test use and is rejected in production.
DEMO_AUTH_ENABLED=false

# Synthetic provider adapter switch. Must be false outside local/test use and is rejected in production.
MOCK_INTEGRATIONS_ENABLED=false

# PostgreSQL connection URL. Supply credentials through the runtime secret store outside local development.
DATABASE_URL=postgresql://localhost:5432/outcomeos

# Redis connection URL used for future job coordination and rate limiting.
REDIS_URL=redis://localhost:6379/0

# Base URL of an S3-compatible object store reserved for future evidence storage.
S3_ENDPOINT=http://localhost:9000

# Object-store access key identifier. Supply the value through a secret manager.
S3_ACCESS_KEY_ID=

# Object-store secret access key. Supply the value through a secret manager.
S3_SECRET_ACCESS_KEY=

# Object-store bucket name for local evidence objects.
S3_BUCKET=outcomeos-local

# Browser-visible API origin; never place a secret in a NEXT_PUBLIC variable.
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostgreSQL container settings used only by the local Docker Compose service. Set a local password
# and keep DATABASE_URL above consistent with these values before starting the applications.
POSTGRES_DB=outcomeos
POSTGRES_USER=outcomeos
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Background worker polling interval in seconds.
WORKER_POLL_INTERVAL_SECONDS=5
